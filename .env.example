# 复制为 .env 后填入真实值。.env 已在 .gitignore 里，不会被提交。

# 火山方舟 API Key（必填）。控制台「API Key 管理」创建。
ARK_API_KEY=

# 以下全部可选：不填就用代码里的默认值，默认值是实测可用的，一般不用动。
#
# 模型可用性随账号和「是否已开通」而变，同一 ID 在不同账号下可能返回
# InvalidEndpointOrModel.NotFound 或 ModelNotOpen。遇到这两类报错时，
# 用下面的变量换成你账号可用的 ID即可。
# 查你账号能用哪些：GET https://ark.cn-beijing.volces.com/api/v3/models
# （注意列表里 status=Shutdown 的是已下线模型，列出来也调不通）

# 文本模型：把诗词拆成五个画面字段
# ARK_TEXT_MODEL=doubao-seed-2-1-pro-260915
#   便宜的替代：doubao-seed-2-0-lite-260428 / doubao-seed-2-0-mini-260428
#   也可以换成 deepseek-v4-pro-260425、glm-5-2-260617

# 图像模型：生成背景图
# ARK_IMAGE_MODEL=doubao-seedream-4-0-250828
#   同账号可用的还有：doubao-seedream-4-5-251128 / doubao-seedream-5-0-260128

# 出图尺寸。不同模型版本支持的值不同：
#   Seedream 4.x / 5.x 可用 '1K' / '2K' / '4K'
#   实测 2K + 竖版提示词会出 1728x2304（正好 3:4）
# ARK_IMAGE_SIZE=2K

# 图片回传方式：b64_json（默认，少一次外网回源）或 url
# ARK_IMAGE_RESPONSE_FORMAT=b64_json

# 自建网关 / 代理时才需要改
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
